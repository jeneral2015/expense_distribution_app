rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Legacy rule for old code collectionGroup query
    match /{path=**}/sub_accounts/{accountId} {
      allow read: if request.auth != null && request.auth.uid == accountId;
    }
    match /users/{userId}/sub_accounts/{accountId} {
      allow read: if request.auth != null && request.auth.uid == accountId;
    }
    match /sub_account_parents/{accountId} {
      allow read: if request.auth != null && request.auth.uid == accountId;
      allow write: if request.auth != null;
    }
  }
}
