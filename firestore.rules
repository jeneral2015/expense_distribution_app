rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSubAccountOf(userId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/sub_account_parents/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sub_account_parents/$(request.auth.uid)).data.parentId == userId;
    }

    function getSubAccountDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/sub_accounts/$(request.auth.uid)).data;
    }

    function hasDatabaseAccess(userId) {
      return isOwner(userId) || (
        isSubAccountOf(userId) &&
        exists(/databases/$(database)/documents/users/$(userId)/sub_accounts/$(request.auth.uid)) &&
        getSubAccountDoc(userId).permissions.page_database == true
      );
    }

    function canUploadDatabase(userId) {
      return isOwner(userId) || (
        isSubAccountOf(userId) &&
        exists(/databases/$(database)/documents/users/$(userId)/sub_accounts/$(request.auth.uid)) &&
        getSubAccountDoc(userId).permissions.page_database == true &&
        getSubAccountDoc(userId).role != 'مراقب'
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /tables/{table} {
        allow read: if hasDatabaseAccess(userId);
        allow write: if canUploadDatabase(userId);
      }

      match /meta/{docId} {
        allow read: if hasDatabaseAccess(userId);
        allow write: if canUploadDatabase(userId);
      }

      match /sub_accounts/{accountId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == accountId);
        allow write: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy rule for old code collectionGroup query
    match /{path=**}/sub_accounts/{accountId} {
      allow read: if isAuthenticated() && request.auth.uid == accountId;
    }

    match /sub_account_parents/{accountId} {
      allow read: if isAuthenticated() && request.auth.uid == accountId;
      allow write: if isAuthenticated();
    }
  }
}
